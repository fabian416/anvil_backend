# Secrets Template - Copy to .secrets.toml and fill in your API keys
# DO NOT COMMIT .secrets.toml TO GIT

# PostgreSQL credentials
[postgres]
USER = "postgres"
PASSWORD = "changethis"

# Security settings
[security.auth]
JWT_SECRET = "your-super-secret-jwt-key-change-in-production"
JWT_ALGORITHM = "HS256"
SESSION_TTL_MIN = 60
SESSION_REFRESH_THRESHOLD = 0.5

[security.cookies]
SECURE = false

[security.password]
PEPPER = "your-password-pepper-change-in-production"

# Privy Configuration
[privy]
APP_SECRET = "your-privy-app-secret"

# ========================================
# LLM Providers (Agent Squad)
# ========================================

# Vertex AI (Google Gemini) - Primary Provider
[vertex_ai]
API_KEY = "your-vertex-ai-api-key-here"
# Get from: https://aistudio.google.com/app/apikey
# Cost: $0.10/1M input tokens, $0.40/1M output tokens

# DeepInfra (Meta Llama) - Fallback Provider
[deepinfra]
API_KEY = "your-deepinfra-api-key-here"
BASE_URL = "https://api.deepinfra.com/v1/openai"
# Get from: https://deepinfra.com/dash/api_keys
# Cost: $0.08/1M tokens

# OpenAI (Optional) - Alternative Provider
[openai]
API_KEY = ""
# Get from: https://platform.openai.com/api-keys
# Cost: $5.00/1M input, $15.00/1M output (GPT-4o)

