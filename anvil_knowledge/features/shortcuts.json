  "command_categories": {
    "trading_swaps": {
      "title": "💱 Trading & Token Swaps",
      "description": "Execute token swaps across multiple DEXs with best-rate optimization",
      "intent": "SWAP",
      "commands": [
        {
          "pattern": "swap [amount] [from_token] to [to_token]",
          "examples": [
            "swap 100 USDC to ETH",
            "exchange 0.5 BTC for SOL",
            "convert 1000 USDT to USDC",
            "trade 50 DAI to MATIC"
          ],
          "multi_language": {
            "spanish": ["cambiar 100 USDC a ETH", "intercambiar 0.5 BTC por SOL"],
            "portuguese": ["trocar 100 USDC para ETH", "converter 0.5 BTC em SOL"],
            "chinese": ["兑换100 USDC到ETH", "交换0.5 BTC为SOL"]
          },
          "response_type": "Rate comparison across aggregators (1inch, Hyperliquid, UniswapX) with gas costs and slippage",
          "execution": "Automatic best-rate selection with MEV protection"
        },
        {
          "pattern": "what's the rate for [from_token] to [to_token]?",
          "examples": [
            "what's the rate for ETH to USDC?",
            "how much USDC for 1 ETH?",
            "exchange rate BTC to SOL"
          ],
          "response_type": "Current exchange rate across multiple DEXs",
          "execution": "Read-only query (no transaction)"
        }
      ]
    },

