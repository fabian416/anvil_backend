    "market_intelligence": {
      "title": "📊 Hunter AI - Market Intelligence",
      "description": "Advanced AI-powered market analysis, sentiment tracking, and predictions",
      "intent_group": ["HUNTER_SENTIMENT", "HUNTER_PRICE_PREDICTION", "HUNTER_RISK_SIGNALS", "HUNTER_TRADING_SIGNALS", "HUNTER_PATTERNS", "HUNTER_PORTFOLIO"],
      "commands": [
