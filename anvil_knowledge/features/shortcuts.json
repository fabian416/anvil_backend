        "applies_to": ["swap"],
        "example": "swap 100 USDC to PURR with 1% slippage",
        "effect": "Set custom slippage tolerance"
      },
      {
        "modifier": "on [chain]",
        "applies_to": ["arbitrage", "protocol_search"],
