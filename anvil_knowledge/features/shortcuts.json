  "command_categories": {
    "trading_swaps": {
      "title": "💱 Trading & Token Swaps (Hyperliquid Spot)",
      "description": "Execute MEME TOKEN swaps via Hyperliquid Spot. IMPORTANT: Only meme tokens (PURR, TRUMP, PEPE, etc.) paired with USDC are supported. Major tokens (ETH, BTC, SOL) are NOT available for swaps.",
      "intent": "SWAP",
      "limitation": "Hyperliquid Spot ONLY supports meme tokens paired with USDC. ETH, BTC, SOL, WBTC, LINK, etc. are NOT supported.",
      "commands": [
        {
          "pattern": "swap [amount] USDC to [meme_token]",
          "examples": [
            "swap 100 USDC to PURR",
            "swap 50 USDC to TRUMP",
            "swap 1000 USDC to PEPE",
            "exchange 200 USDC for HFUN"
          ],
          "supported_tokens": ["PURR", "TRUMP", "PEPE", "HFUN", "MOG", "GMEOW", "LICK", "MANLET", "JEFF", "WAGMI"],
          "not_supported": ["ETH", "BTC", "SOL", "WBTC", "LINK", "UNI", "AAVE", "CRV", "MKR"],
          "multi_language": {
            "spanish": ["cambiar 100 USDC a PURR", "intercambiar 50 USDC por TRUMP"],
            "portuguese": ["trocar 100 USDC para PURR", "converter 50 USDC em TRUMP"],
            "chinese": ["兑换100 USDC到PURR", "交换50 USDC为TRUMP"]
          },
          "response_type": "Real-time quote from Hyperliquid Spot order book with spread and output amount",
          "execution": "Zero gas fees, 0.02% trading fee, sub-second execution on Hyperliquid L1"
        },
        {
          "pattern": "swap [amount] [meme_token] to USDC",
          "examples": [
            "swap 1000 PURR to USDC",
            "sell 500 TRUMP for USDC",
            "convert my PEPE to USDC"
          ],
          "response_type": "Real-time sell quote from Hyperliquid Spot",
          "execution": "Zero gas fees, instant settlement"
        },
        {
          "pattern": "what's the rate for [token] to [token]?",
          "examples": [
            "what's the rate for PURR to USDC?",
            "how much USDC for 1000 TRUMP?",
            "PEPE price"
          ],
          "response_type": "Current exchange rate from Hyperliquid Spot order book",
          "execution": "Read-only query (no transaction)"
        }
      ],
      "why_meme_tokens_only": "Hyperliquid is primarily a perpetual futures exchange. Their Spot market only offers meme token trading. For major tokens like ETH/BTC, use Hyperliquid Perps or external DEX aggregators."
    },

