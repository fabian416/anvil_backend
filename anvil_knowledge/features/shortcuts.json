  "api_integration": {
    "description": "For developers building on Anvil API",
    "endpoint": "POST /api/v1/conversations/{conversation_id}/messages",
    "request_format": {
      "content": "string (required) - The user's message/command",
      "language": "string (optional) - Language code (en, es, pt, zh)"
    },
    "response_format": {
      "user_message": "User's message object",
      "agent_message": "Anvil's response object",
      "routing": {
        "intent": "Detected intent type",
        "confidence": "Confidence score (0.0-1.0)",
        "handler": "Handler that processed the request"
      },
      "enrichment": "Intent-specific structured data"
    },
    "authentication": "Bearer token in Authorization header (from /api/v1/account/login)",
    "rate_limits": {
      "authenticated": "100 requests/minute",
      "guest": "10 requests/minute"
    }
  },

