  "command_modifiers": {
    "description": "Additional modifiers that can be applied to commands for enhanced functionality",
    "modifiers": [
      {
        "modifier": "with slippage [percentage]",
        "applies_to": ["swap"],
        "example": "swap 100 USDC to ETH with 1% slippage",
        "effect": "Set custom slippage tolerance"
      },
      {
        "modifier": "on [chain]",
        "applies_to": ["swap", "arbitrage", "protocol_search"],
        "example": "swap 100 USDC to ETH on Arbitrum",
        "effect": "Specify blockchain network",
        "supported_chains": ["Ethereum", "Arbitrum", "Polygon", "Optimism", "Base", "Solana"]
      },
      {
        "modifier": "for [time_period]",
        "applies_to": ["price_prediction", "sentiment_analysis"],
        "example": "predict BTC price for 7 days",
        "effect": "Specify time horizon",
        "supported_periods": ["24 hours", "1 week", "1 month"]
      },
      {
        "modifier": "in [language]",
        "applies_to": ["all"],
        "example": "swap 100 USDC to ETH (responds in user's language)",
        "effect": "Set response language",
        "supported_languages": ["en", "es", "pt", "zh"]
      }
    ]
  },

  "multi_step_flows": {
    "description": "Commands that trigger interactive multi-step conversations",
    "flows": [
      {
        "trigger": "I want to swap",
        "steps": [
          "Anvil: Great! How much do you want to swap?",
          "User: 100 USDC",
          "Anvil: Perfect! What token would you like to receive?",
          "User: ETH",
          "Anvil: [Shows rate comparison and executes swap]"
        ],
        "use_case": "Incomplete swap requests trigger interactive flow"
      },
      {
        "trigger": "tell me about [protocol]",
        "steps": [
          "Anvil: [Provides protocol overview]",
          "Anvil: Would you like to see: 1) Risk assessment, 2) Similar protocols, 3) How to use it?",
          "User: risk assessment",
          "Anvil: [Shows detailed risk analysis]"
        ],
        "use_case": "Protocol research can lead to deeper exploration"
      }
    ]
  },

  "cancellation_keywords": {
    "description": "Keywords to cancel ongoing multi-step flows and return to main conversation",
    "keywords": [
      "cancel",
      "stop",
      "nevermind",
      "forget it",
      "exit",
      "cancelar (Spanish)",
      "parar (Spanish)",
      "cancelar (Portuguese)",
      "parar (Portuguese)",
      "取消 (Chinese)"
    ],
    "effect": "Immediately cancels ongoing flow and clears conversation state"
  },

  "power_user_tips": {
    "description": "Advanced tips for power users to maximize Anvil efficiency",
    "tips": [
      {
        "tip": "Chain multiple commands",
        "description": "You can reference previous results in follow-up queries",
        "example": "User: 'show arbitrage with $10k' → Anvil: [shows ARB-001] → User: 'execute ARB-001 with MEV protection'"
      },
      {
        "tip": "Use natural language variations",
        "description": "Anvil understands many ways to phrase the same command",
        "example": "'swap 100 USDC to ETH' = 'exchange 100 USDC for ETH' = 'convert 100 USDC to ETH'"
      },
      {
        "tip": "Combine features in one query",
        "description": "Request multiple analyses in a single message",
        "example": "'show me BTC price, sentiment, and trading signals'"
      },
      {
        "tip": "Reference tokens by symbol or name",
        "description": "Anvil recognizes both ticker symbols and full names",
        "example": "'BTC' = 'Bitcoin', 'ETH' = 'Ethereum', 'USDC' = 'USD Coin'"
      },
      {
        "tip": "Use comparative queries",
        "description": "Compare multiple tokens or protocols in one query",
        "example": "'compare lending rates on Aave vs Compound for USDC'"
      }
    ]
  },

