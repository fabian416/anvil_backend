    "command_coverage": "16 intent types covering 95% of DeFi use cases",
    "multi_language": "Native support for 4 languages (not translations) expands TAM by 3x",
    "user_experience": "Single endpoint, natural commands vs 10+ different protocol UIs",
    "developer_experience": "Simple REST API for integration vs complex protocol-specific SDKs"
  }
