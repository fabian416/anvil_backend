  "edge_cases": [
    {
      "id": "edge_001",
      "description": "Empty message",
      "input": {
        "content": ""
      },
      "expected_error": {
        "status_code": 422,
        "error_type": "validation_error"
      }
    },
    {
      "id": "edge_002",
      "description": "Very long message",
      "input": {
        "content": "A".repeat(10000)
      },
      "expected_error": {
        "status_code": 422,
        "error_type": "validation_error"
      }
    },
    {
      "id": "edge_003",
      "description": "Special characters",
      "input": {
        "content": "Show me protocols with <script>alert('xss')</script>"
      },
      "expected_routing": {
        "intent": "protocol_search",
        "content_sanitized": true
      }
    },
    {
      "id": "edge_004",
      "description": "Multiple intents in one message",
      "input": {
        "content": "Show me DeFi protocols and also predict BTC price"
      },
      "expected_routing": {
        "intent": "protocol_search",
        "note": "First intent detected takes precedence"
      }
