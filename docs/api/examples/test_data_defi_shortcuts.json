  "validation_rules": {
    "response_structure": {
      "required_fields": ["user_message", "agent_message", "routing"],
      "routing_fields": ["intent", "confidence", "handler", "reasoning"],
      "message_fields": ["id", "conversation_id", "role", "content", "created_at"]
    },
    "handler_mapping": {
      "lending": "lending_handler",
      "money_market": "money_market_handler",
      "swap": "swap_handler",
      "portfolio": "portfolio_handler",
      "balance": "portfolio_handler",
      "activity": "activity_handler",
      "receive": "receive_handler"
    },
    "confidence_thresholds": {
      "high": 0.9,
      "medium": 0.7,
      "low": 0.5
    }
  }
}
