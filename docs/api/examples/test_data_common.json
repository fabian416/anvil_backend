  "edge_cases": [
    {
      "id": "edge_001",
      "description": "Empty message",
      "input": {
        "content": ""
      },
      "expected_error": {
        "status_code": 422,
        "error_type": "validation_error"
      },
      "output": {
        "content": "Message content cannot be empty or whitespace only."
      }
    },
    {
      "id": "edge_002",
      "description": "Very long message",
      "input": {
        "content": ""
      },
      "expected_error": {
        "status_code": 422,
        "error_type": "validation_error"
      },
      "output": {
        "content": "Message content exceeds maximum allowed length."
      }
    },
    {
      "id": "edge_003",
      "description": "Special characters",
      "input": {
        "content": "Show me protocols with <script>alert('xss')</script>"
      },
      "expected_routing": {
        "intent": "protocol_search",
        "content_sanitized": true
      },
      "output": {
        "content": "Searching for protocols. Note: Unsafe characters were removed from your request."
      }
    },
    {
      "id": "edge_004",
      "description": "Multiple intents in one message",
      "input": {
        "content": "Show me DeFi protocols and also predict BTC price"
      },
      "expected_routing": {
        "intent": "protocol_search",
        "note": "First intent detected takes precedence"
      },
      "output": {
        "content": "I'll Search for DeFi protocols as requested."
      }
    }
  ],
