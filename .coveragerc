# Coverage.py configuration
# https://coverage.readthedocs.io/en/latest/config.html

[run]
source = src/app
omit =
    */tests/*
    */test_*.py
    */__init__.py
    */setup/*
    */migrations/*
    */conftest.py

[report]
precision = 2
show_missing = True
skip_covered = False

exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod

[html]
directory = htmlcov

[xml]
output = coverage.xml
