### Creating New Async Workflows

**✅ DO: Follow Service Layer Pattern**
```python
# Step 1: Create service class
# File: src/services/my_feature/my_service.py
class MyFeatureService:
    async def process_feature(self, ...):
        # ALL business logic here
        pass

# Step 2: Create thin endpoint
# File: src/routes/my_feature_async.py
@router.post("/my-feature/async/")
async def start_async_feature(request: FeatureRequest):
    # Enqueue task
    task = celery_app.send_task("my_feature.process", ...)
    
    # Schedule post-enqueue tasks (if needed)
    if simple_flow:
        # Pattern 1: Schedule in endpoint
        celery_app.send_task("validation.fix_and_retry", ..., countdown=5)
    
    return JSONResponse({"task_id": task.id}, status_code=202)

# Step 3: Create thin worker
# File: src/tasks/my_feature_tasks.py
@celery_app.task(name="my_feature.process")
def process_feature_task(...):
    service = MyFeatureService()
    result = asyncio.run(service.process_feature(...))
    
    if complex_flow:
        # Pattern 2: Schedule in worker
        celery_app.send_task("validation.fix_and_retry", ..., countdown=5)
    
    return result
```

